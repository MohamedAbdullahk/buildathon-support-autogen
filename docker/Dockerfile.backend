# 1. Base image: small official Python 3.11 (same version as your venv)
FROM python:3.11-slim

# 2. Python settings for containers
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 3. Working folder inside the container
WORKDIR /app

# 4. Install dependencies FIRST (cached layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy backend code (changes often, so it comes last)
COPY backend/ ./backend/

# 6. Folders for runtime data (mounted as volumes later)
RUN mkdir -p data logs

# 7. Document the port the API listens on
EXPOSE 8000

# 8. Docker checks /health every 30s
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# 9. Start the API (no reload in production)
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]